# Postgres
POSTGRES_USER=bouquet
POSTGRES_PASSWORD=bouquet_dev_pwd
POSTGRES_DB=bouquet
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:5173
MEDIA_DIR=/app/media
MEDIA_BASE_URL=/media
AI_PROVIDER=mock
ENV=dev

# First superadmin (created by seed on first run)
SUPERADMIN_EMAIL=admin@bouquet.local
SUPERADMIN_PASSWORD=admin12345

# AI pipeline (set AI_PROVIDER=comfyui to enable real generation)
LLM_BASE_URL=http://192.168.88.45:8050/v1
LLM_API_KEY=YOUR_API_KEY
LLM_MODEL=current-LLM
LLM_TIMEOUT_SEC=60

COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_TIMEOUT_SEC=300
COMFYUI_POLL_INTERVAL_SEC=1.5

# Frontend (Vite uses VITE_ prefix). Leave empty to use same-origin proxy
# (vite dev proxy in development; nginx in docker). Set explicitly only if
# the frontend is hosted on a different origin from the backend.
VITE_API_BASE=
